<Window x:Class="VibeUninstaller.App.Views.BatchUninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VibeUninstaller.App.Converters"
        Title="Uninstall selected applications" Height="720" Width="960" MinHeight="560" MinWidth="780"
        Icon="pack://application:,,,/VibeUninstaller;component/Assets/app.ico" Style="{StaticResource WindowStyle}" WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <conv:BytesToSizeConverter x:Key="SizeConverter" />
    <conv:StateToVisibilityConverter x:Key="StateVisibility" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
    <conv:TierToBrushConverter x:Key="TierBrush" />
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="2,0,2,12">
      <TextBlock Text="Uninstall selected applications" Style="{StaticResource TitleText}" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionText}"
                 Text="Each application's own uninstaller runs in turn. Nothing beyond those uninstallers happens until you review the leftovers at the end." />
    </StackPanel>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Application status list -->
      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8,10" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding HeaderText}" Style="{StaticResource SidebarHeaderText}" Margin="6,0,0,8" />
          <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                          VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource MutedTextBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="Running">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="Completed">
                            <Setter Property="Background" Value="{DynamicResource SafeBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="Failed">
                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="Canceled">
                            <Setter Property="Background" Value="{DynamicResource ModerateBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  </StackPanel>

                  <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Style="{StaticResource CaptionText}"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Phase panels -->
      <Grid Grid.Column="1">

        <!-- Confirm -->
        <Border Padding="18" CornerRadius="10" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Confirm}">
          <StackPanel>
            <TextBlock Text="Options" Style="{StaticResource SectionText}" />
            <CheckBox Content="Use silent switches when the installer family is known" IsChecked="{Binding UseSilent}" Margin="0,12,0,0" />
            <CheckBox Content="Scan for leftovers after each uninstall" IsChecked="{Binding ScanLeftovers}" Margin="0,9,0,0" />
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="Uninstallers without a known silent switch may open their own windows. The batch simply waits for them to finish." />
            <Border Margin="0,16,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource PanelAltBackground}">
              <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                         Text="Safety: reviewed files always go to the Recycle Bin, and registry keys are exported to .reg backups unless you turn that off in the review step." />
            </Border>
          </StackPanel>
        </Border>

        <!-- Running -->
        <Border Padding="18" CornerRadius="10" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Running}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StageText}" Style="{StaticResource SectionText}" TextWrapping="Wrap" />
            <ProgressBar Grid.Row="1" Height="4" Margin="0,12,0,12" IsIndeterminate="True" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11"
                     Background="{DynamicResource LogBackgroundBrush}" />
          </Grid>
        </Border>

        <!-- Review -->
        <Border Padding="18" CornerRadius="10" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Review}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="0,0,0,10" />

            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Select recommended" Click="SelectRecommended_Click" />
                <Button Content="Select all" Margin="8,0,0,0" Click="SelectAll_Click" />
                <Button Content="Select none" Margin="8,0,0,0" Click="SelectNone_Click" />
              </StackPanel>
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                         Text="{Binding SizeComputationText}" />
            </Grid>

            <ListBox Grid.Row="2" ItemsSource="{Binding Leftovers}" Padding="4">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="2,2,2,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,0,0" />

                    <Border Grid.Column="1" MinWidth="52" Height="18" CornerRadius="9" Margin="10,2,10,0" VerticalAlignment="Top"
                            Background="{Binding Tier, Converter={StaticResource TierBrush}}">
                      <TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="{DynamicResource TierInkBrush}" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding Reason}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                 TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" MinWidth="70">
                      <TextBlock Text="{Binding KindLabel}" FontSize="10" HorizontalAlignment="Right"
                                 Foreground="{DynamicResource MutedTextBrush}" />
                      <TextBlock Text="{Binding SizeBytes, Converter={StaticResource SizeConverter}}" FontSize="11"
                                 HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
              <CheckBox Content="Back up registry keys to .reg files before deleting them"
                        IsChecked="{Binding BackupRegistryKeys}" />
              <TextBlock Text="{Binding BackupNote}" Margin="24,4,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding BackupNoteIsWarning}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource ModerateBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Removing -->
        <Border Padding="18" CornerRadius="10" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Removing}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding StageText}" Style="{StaticResource SectionText}" />
            <ProgressBar Grid.Row="1" Height="4" Margin="0,12,0,12" IsIndeterminate="True" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11"
                     Background="{DynamicResource LogBackgroundBrush}" />
          </Grid>
        </Border>

        <!-- Done -->
        <Border Padding="18" CornerRadius="10" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Done}">
          <StackPanel>
            <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RemovalSummary}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding RemovalSummary, Converter={StaticResource EmptyStringToVisibility}}" />
            <Button Content="Open leftovers backup folder" Margin="0,14,0,0" HorizontalAlignment="Left"
                    Command="{Binding OpenVaultCommand}" />

            <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource DangerPanelBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                    Visibility="{Binding ErrorText, Converter={StaticResource EmptyStringToVisibility}}">
              <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontSize="12" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="2" Margin="2,14,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button Content="{Binding StartButtonText}" Style="{StaticResource DangerButton}" Click="Start_Click"
                Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Confirm}" />
        <Button Content="Cancel running uninstall" Click="Cancel_Click"
                Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Running}" />
        <Button Content="Remove selected" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                Command="{Binding RemoveSelectedCommand}"
                Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Review}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource CaptionText}"
                   Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Review}">
          <Run Text="{Binding SelectedCount, Mode=OneWay}" />
          <Run Text=" selected · " />
          <Run Text="{Binding SelectedBytes, Converter={StaticResource SizeConverter}, Mode=OneWay}" />
        </TextBlock>
        <Button Content="Close" Click="Close_Click" IsEnabled="{Binding CanClose}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
