<Window x:Class="VibeUninstaller.App.Views.UninstallFlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VibeUninstaller.App.Converters"
        Title="Uninstall" Height="700" Width="900" MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <conv:BytesToSizeConverter x:Key="SizeConverter" />
    <conv:StateToVisibilityConverter x:Key="StateVisibility" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
    <conv:TierToBrushConverter x:Key="TierBrush" />
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="2,0,2,12">
      <TextBlock Text="{Binding App.DisplayName}" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding SelectedAppDetails}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
    </StackPanel>

    <!-- Content -->
    <Grid Grid.Row="1">

      <!-- Confirm -->
      <Border Padding="18" CornerRadius="10" Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Confirm}">
        <StackPanel>
          <TextBlock Text="VibeUninstaller runs the application's own uninstaller first, then compares the system before and after to find what was left behind."
                     TextWrapping="Wrap" />

          <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="{StaticResource PanelAltBackground}">
            <StackPanel>
              <TextBlock Style="{StaticResource CaptionText}">
                <Run Text="Installer technology: " /><Run Text="{Binding Installer.FamilyLabel, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="Install location: " /><Run Text="{Binding App.InstallLocation, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="Command: " /><Run Text="{Binding App.UninstallString, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Border>

          <CheckBox Margin="0,16,0,0" Content="Scan for leftovers after the uninstall"
                    IsChecked="{Binding ScanLeftovers}" IsEnabled="{Binding CanScanLeftovers}" />
          <TextBlock Text="{Binding ScanNote}" Style="{StaticResource CaptionText}" Margin="24,4,0,0" TextWrapping="Wrap" />

          <CheckBox Margin="0,14,0,0" Content="Run unattended (silent switches) when available"
                    IsChecked="{Binding UseSilent}" IsEnabled="{Binding CanUseSilent}" />
          <TextBlock Text="{Binding SilentNote}" Style="{StaticResource CaptionText}" Margin="24,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Running -->
      <Border Padding="18" CornerRadius="10" Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Running}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{Binding StageText}" Style="{StaticResource SectionText}" TextWrapping="Wrap" />
          <ProgressBar Grid.Row="1" Height="4" Margin="0,12,0,12" IsIndeterminate="True" />
          <ListBox Grid.Row="2" x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11"
                   Background="#FF14161B" />
        </Grid>
      </Border>

      <!-- Review -->
      <Grid Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Review}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ResultSummary}" TextWrapping="Wrap" Margin="2,0,2,10" />

        <Grid Grid.Row="1" Margin="2,0,2,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button Content="Select recommended" Click="SelectRecommended_Click" />
            <Button Content="Select all" Margin="8,0,0,0" Click="SelectAll_Click" />
            <Button Content="Select none" Margin="8,0,0,0" Click="SelectNone_Click" />
          </StackPanel>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                     Text="{Binding SizeComputationText}" />
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Leftovers}" Padding="4">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,2,2,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,0,0" />

                <Border Grid.Column="1" MinWidth="52" Height="18" CornerRadius="9" Margin="10,2,10,0" VerticalAlignment="Top"
                        Background="{Binding Tier, Converter={StaticResource TierBrush}}">
                  <TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="#FF10131A" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding Reason}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                             TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Right" MinWidth="70">
                  <TextBlock Text="{Binding KindLabel}" FontSize="10" HorizontalAlignment="Right"
                             Foreground="{StaticResource MutedTextBrush}" />
                  <TextBlock Text="{Binding SizeBytes, Converter={StaticResource SizeConverter}}" FontSize="11"
                             HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- Removing -->
      <Border Padding="18" CornerRadius="10" Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Removing}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{Binding StageText}" Style="{StaticResource SectionText}" />
          <ProgressBar Grid.Row="1" Height="4" Margin="0,12,0,12" IsIndeterminate="True" />
          <ListBox Grid.Row="2" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11" Background="#FF14161B" />
        </Grid>
      </Border>

      <!-- Done -->
      <Border Padding="18" CornerRadius="10" Background="{StaticResource PanelBackground}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Done}">
        <StackPanel>
          <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding RemovalSummary}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Visibility="{Binding RemovalSummary, Converter={StaticResource EmptyStringToVisibility}}" />
          <Button Content="Open leftovers backup folder" Margin="0,14,0,0" HorizontalAlignment="Left"
                  Command="{Binding OpenVaultCommand}" />

          <Border Margin="0,14,0,0" Padding="12" CornerRadius="8" Background="#FF2A1A1A"
                  BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                  Visibility="{Binding ErrorText, Converter={StaticResource EmptyStringToVisibility}}">
            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontSize="12" />
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="2" Margin="2,14,2,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Confirm}">
        <Button Content="Cancel" Click="Close_Click" Margin="0,0,8,0" />
        <Button x:Name="StartButton" Content="Uninstall" Style="{StaticResource PrimaryButton}" Click="Start_Click" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Running}">
        <Button Content="Cancel operation" Click="CancelOperation_Click" />
      </StackPanel>

      <Grid Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Review}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource CaptionText}">
          <Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" selected · " /><Run Text="{Binding SelectedBytes, Mode=OneWay, Converter={StaticResource SizeConverter}}" />
        </TextBlock>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Close" Click="Close_Click" Margin="0,0,8,0" />
          <Button Content="Remove selected" Style="{StaticResource DangerButton}" Command="{Binding RemoveSelectedCommand}" />
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Removing}">
        <TextBlock Text="Removing leftovers..." Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  Visibility="{Binding StateName, Converter={StaticResource StateVisibility}, ConverterParameter=Done}">
        <Button Content="Close" Style="{StaticResource PrimaryButton}" Click="Close_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
