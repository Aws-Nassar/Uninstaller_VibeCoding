<Window x:Class="VibeUninstaller.App.Views.ScanPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VibeUninstaller.App.Converters"
        Title="Leftover scan" Height="640" Width="860" MinHeight="480" MinWidth="700"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <conv:BytesToSizeConverter x:Key="SizeConverter" />
    <conv:TierToBrushConverter x:Key="TierBrush" />
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="2,0,2,14">
      <StackPanel Orientation="Horizontal">
        <Border Width="36" Height="36" CornerRadius="9" Background="{Binding Item.LettermarkBrush}">
          <TextBlock Text="{Binding Item.Lettermark}" Foreground="White" FontWeight="SemiBold" FontSize="16"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Item.DisplayName}" Style="{StaticResource TitleText}" FontSize="17"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Fingerprint scan — nothing is changed by this preview" Style="{StaticResource CaptionText}"
                     Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- Content -->
    <Grid Grid.Row="1">
      <Border Style="{StaticResource CardBorder}" Padding="18"
              Visibility="{Binding IsScanning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
        <StackPanel>
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource SectionText}" TextWrapping="Wrap" />
          <ProgressBar Height="4" Margin="0,14,0,0" IsIndeterminate="True" />
        </StackPanel>
      </Border>

      <Grid Visibility="{Binding IsNotScanning, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="2,0,2,10" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Padding="4">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" MinWidth="52" Height="18" CornerRadius="9" Margin="0,2,10,0"
                        VerticalAlignment="Top" Background="{Binding Tier, Converter={StaticResource TierBrush}}">
                  <TextBlock Text="{Binding TierLabel}" FontSize="10" Foreground="#FF10131A" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Reason}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                             TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" MinWidth="70">
                  <TextBlock Text="{Binding KindLabel}" FontSize="10" HorizontalAlignment="Right"
                             Foreground="{StaticResource MutedTextBrush}" />
                  <TextBlock Text="{Binding SizeBytes, Converter={StaticResource SizeConverter}}" FontSize="11"
                             HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="2" Margin="2,14,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Close" Click="Close_Click" Margin="0,0,8,0" />
        <Button Content="Run uninstaller…" Style="{StaticResource PrimaryButton}" Click="RunUninstaller_Click"
                IsEnabled="{Binding IsNotScanning}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
