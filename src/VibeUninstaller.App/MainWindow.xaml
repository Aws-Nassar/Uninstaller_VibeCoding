<Window x:Class="VibeUninstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VibeUninstaller.App.Converters"
        xmlns:vm="clr-namespace:VibeUninstaller.App.ViewModels"
        xmlns:models="clr-namespace:VibeUninstaller.Core.Models;assembly=VibeUninstaller.Core"
        Title="VibeUninstaller" Height="820" Width="1280" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Window.Resources>
    <conv:BytesToSizeConverter x:Key="SizeConverter" />
    <conv:EqualsConverter x:Key="EqualsConverter" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVisible" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Brand -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
            <TextBlock Text="V" Foreground="White" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="VibeUninstaller" Style="{StaticResource TitleText}" FontSize="18"
                     Margin="10,0,0,0" VerticalAlignment="Center" />
          <Border Style="{StaticResource PillBorder}" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" />
          </Border>
          <Border Style="{StaticResource PillBorder}" Margin="6,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="free · open source" Style="{StaticResource CaptionText}" />
          </Border>
        </StackPanel>

        <!-- Search -->
        <Grid Grid.Column="1" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="{StaticResource MutedTextBrush}" Margin="11,0,0,0"
                     HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBox x:Name="SearchBox" Padding="32,7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Search by name or publisher" />
          <TextBlock Text="Search applications…" Margin="33,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedTextBrush}" IsHitTestVisible="False"
                     Visibility="{Binding IsSearchEmpty, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
          <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="6,4"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                  Command="{Binding ClearSearchCommand}" ToolTip="Clear search">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSearchEmpty}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}"
                  IsEnabled="{Binding IsBusy, Converter={x:Static conv:NotConverter.Instance}}"
                  ToolTip="Rescan installed applications">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0"
                         VerticalAlignment="Center" />
              <TextBlock Text="Refresh" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Style="{StaticResource PillBorder}" Margin="10,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource ModerateBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsElevated}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource SafeBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ElevationText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                    <Setter Property="Foreground" Value="{StaticResource ModerateBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsElevated}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource SafeBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content -->
    <Grid Grid.Row="1" Margin="16,14,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10,12" Margin="0,0,12,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border Background="{StaticResource PanelAltBackground}" CornerRadius="8" Padding="10,9">
              <StackPanel>
                <TextBlock Text="Tip" Style="{StaticResource CaptionText}" FontWeight="SemiBold" />
                <TextBlock Text="Double-click an application to run its uninstaller and scan for leftovers."
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel>
            <TextBlock Text="Library" Style="{StaticResource SidebarHeaderText}" />

            <RadioButton Style="{StaticResource NavToggle}" GroupName="LibraryView"
                         Command="{Binding SetViewCommand}" CommandParameter="{x:Static models:AppListView.Programs}"
                         IsChecked="{Binding View, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Programs}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgramsCount}" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Programs" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource NavToggle}" GroupName="LibraryView"
                         Command="{Binding SetViewCommand}" CommandParameter="{x:Static models:AppListView.Store}"
                         IsChecked="{Binding View, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Store}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StoreCount}" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Store apps" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource NavToggle}" GroupName="LibraryView"
                         Command="{Binding SetViewCommand}" CommandParameter="{x:Static models:AppListView.Updates}"
                         IsChecked="{Binding View, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Updates}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatesCount}" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Updates" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource NavToggle}" GroupName="LibraryView"
                         Command="{Binding SetViewCommand}" CommandParameter="{x:Static models:AppListView.Everything}"
                         IsChecked="{Binding View, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Everything}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding EverythingCount}" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Everything" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </RadioButton>

            <TextBlock Text="Quick filters" Style="{StaticResource SidebarHeaderText}" Margin="8,16,0,6" />
            <CheckBox Content="Large apps only (1 GB+)" IsChecked="{Binding LargeAppsOnly}" Margin="6,0,0,0" />
            <CheckBox Content="Recently installed (90 days)" IsChecked="{Binding RecentlyInstalledOnly}" Margin="6,9,0,0" />

            <Border Margin="0,16,0,0" Background="{StaticResource PanelAltBackground}" CornerRadius="8" Padding="10,9">
              <StackPanel>
                <TextBlock Text="Now showing" Style="{StaticResource CaptionText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FilterSummaryText}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Application list -->
      <Grid Grid.Column="1">
        <DataGrid x:Name="AppsGrid" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                  MouseDoubleClick="AppsGrid_MouseDoubleClick" AlternationCount="2" CanUserSortColumns="True">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Uninstall and scan for leftovers…" Click="Uninstall_Click" />
              <MenuItem Header="Scan for leftovers (no changes)…" Click="Scan_Click" />
              <MenuItem Header="Open install folder" Click="OpenFolder_Click" />
              <MenuItem Header="Copy uninstall command" Click="CopyCommand_Click" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_PreviewMouseRightButtonDown" />
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Application" Width="2.2*" SortMemberPath="DisplayName">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{Binding LettermarkBrush}">
                      <TextBlock Text="{Binding Lettermark}" Foreground="White" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.4*" SortMemberPath="Publisher" />
            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="0.8*" SortMemberPath="Version" />
            <DataGridTextColumn Header="Size"
                                Binding="{Binding EstimatedSizeBytes, Converter={StaticResource SizeConverter}}"
                                Width="0.7*" SortMemberPath="EstimatedSizeBytes" />
            <DataGridTextColumn Header="Installed" Binding="{Binding InstallDateText}" Width="0.8*" SortMemberPath="InstallDateText" />
            <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="0.6*" SortMemberPath="SourceLabel" />
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Apps.Count, Converter={StaticResource ZeroToVisible}}">
          <TextBlock Text="No applications match" Style="{StaticResource SectionText}" HorizontalAlignment="Center" />
          <TextBlock Text="Try a different view or clear the search box." Style="{StaticResource CaptionText}"
                     Margin="0,6,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Details -->
    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="16,12,16,0" Padding="16,14"
            Visibility="{Binding SelectedApp, Converter={StaticResource NullToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <Border Width="30" Height="30" CornerRadius="8" Background="{Binding SelectedApp.LettermarkBrush}">
              <TextBlock Text="{Binding SelectedApp.Lettermark}" Foreground="White" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding SelectedApp.DisplayName}" Style="{StaticResource SectionText}"
                       Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Border Style="{StaticResource PillBorder}" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedApp.InstallerLabel}" Style="{StaticResource CaptionText}" />
            </Border>
          </StackPanel>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="PUBLISHER" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedApp.Publisher}" Style="{StaticResource InfoValue}" Margin="0,2,16,8" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="VERSION" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedApp.Version}" Style="{StaticResource InfoValue}" Margin="0,2,16,8" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="INSTALLED" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedApp.InstallDateText}" Style="{StaticResource InfoValue}" Margin="0,2,16,8" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="SIZE" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedApp.EstimatedSizeBytes, Converter={StaticResource SizeConverter}}"
                       Style="{StaticResource InfoValue}" Margin="0,2,16,8" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="SCOPE" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedApp.ScopeLabel}" Style="{StaticResource InfoValue}" Margin="0,2,16,8" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="SOURCE" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedApp.SourceLabel}" Style="{StaticResource InfoValue}" Margin="0,2,16,8" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="INSTALL LOCATION" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedApp.InstallLocationText}"
                       Style="{StaticResource InfoValue}" Margin="0,2,16,8" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="UNINSTALL COMMAND" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedApp.UninstallCommandText}"
                       Style="{StaticResource InfoValue}" Margin="0,2,16,8" FontFamily="Consolas" FontSize="11.5" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="REGISTRY KEY" Style="{StaticResource InfoLabel}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedApp.RegistryKeyText}"
                       Style="{StaticResource InfoValue}" Margin="0,2,16,0" FontFamily="Consolas" FontSize="11.5" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Width="186" VerticalAlignment="Center">
          <Button Content="Uninstall…" Style="{StaticResource PrimaryButton}" Padding="14,9"
                  Click="Uninstall_Click" ToolTip="Runs the application's own uninstaller, then scans for leftovers" />
          <Button Content="Scan for leftovers" Margin="0,8,0,0" Click="Scan_Click"
                  ToolTip="Preview what could be cleaned up. Nothing is changed." />
          <Button Content="Open install folder" Margin="0,8,0,0" Click="OpenFolder_Click" />
          <Button Content="Copy uninstall command" Margin="0,8,0,0" Click="CopyCommand_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Details placeholder when nothing is selected -->
    <Border Grid.Row="2" Margin="16,12,16,0" Padding="16,14">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedApp}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="Select an application to see its details and cleanup actions."
                 Style="{StaticResource CaptionText}" />
    </Border>

    <!-- Status bar -->
    <Grid Grid.Row="3" Margin="16,10,16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
        <TextBlock Text="  ·  " Style="{StaticResource CaptionText}"
                   Visibility="{Binding WarningText, Converter={StaticResource EmptyStringToVisibility}}" />
        <TextBlock Text="{Binding WarningText}" Style="{StaticResource CaptionText}"
                   Foreground="{StaticResource ModerateBrush}"
                   Visibility="{Binding WarningText, Converter={StaticResource EmptyStringToVisibility}}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding FilterSummaryText}" Style="{StaticResource CaptionText}" />
    </Grid>

    <ProgressBar Grid.Row="3" Height="3" VerticalAlignment="Bottom" IsIndeterminate="True"
                 Visibility="{Binding IsBusy, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
  </Grid>
</Window>
