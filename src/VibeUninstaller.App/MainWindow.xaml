<Window x:Class="VibeUninstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VibeUninstaller.App.Converters"
        xmlns:vm="clr-namespace:VibeUninstaller.App.ViewModels"
        Title="VibeUninstaller" Height="760" Width="1200" MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterScreen">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Window.Resources>
    <conv:BytesToSizeConverter x:Key="SizeConverter" />
    <conv:EqualsConverter x:Key="EqualsConverter" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="2,0,2,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <TextBlock Text="VibeUninstaller" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
        <Border Background="{StaticResource PanelAltBackground}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0"
                VerticalAlignment="Center">
          <TextBlock Text="free · open source" Style="{StaticResource CaptionText}" />
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
        <RadioButton Content="Programs" GroupName="View" Style="{StaticResource FilterToggle}"
                     IsChecked="{Binding ViewFilter, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Programs}"
                     Command="{Binding SetViewFilterCommand}" CommandParameter="Programs" />
        <RadioButton Content="Store apps" GroupName="View" Style="{StaticResource FilterToggle}"
                     IsChecked="{Binding ViewFilter, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Store}"
                     Command="{Binding SetViewFilterCommand}" CommandParameter="Store" />
        <RadioButton Content="Updates" GroupName="View" Style="{StaticResource FilterToggle}"
                     IsChecked="{Binding ViewFilter, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Updates}"
                     Command="{Binding SetViewFilterCommand}" CommandParameter="Updates" />
        <RadioButton Content="Everything" GroupName="View" Style="{StaticResource FilterToggle}"
                     IsChecked="{Binding ViewFilter, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=All}"
                     Command="{Binding SetViewFilterCommand}" CommandParameter="All" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <TextBox Width="240" VerticalAlignment="Center"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Search by name or publisher" />
        <Button Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static conv:NotConverter.Instance}}" />
      </StackPanel>
    </Grid>

    <!-- Application list -->
    <DataGrid x:Name="AppsGrid" Grid.Row="1"
              ItemsSource="{Binding Apps}"
              SelectedItem="{Binding SelectedApp}"
              MouseDoubleClick="AppsGrid_MouseDoubleClick"
              AlternationCount="2"
              CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Application" Width="2.4*" SortMemberPath="DisplayName">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="6" Background="{Binding LettermarkBrush}">
                  <TextBlock Text="{Binding Lettermark}" Foreground="White" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DisplayName}" Margin="10,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.6*" SortMemberPath="Publisher" />
        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="0.9*" SortMemberPath="Version" />
        <DataGridTextColumn Header="Size"
                            Binding="{Binding EstimatedSizeBytes, Converter={StaticResource SizeConverter}}"
                            Width="0.7*" SortMemberPath="EstimatedSizeBytes" />
        <DataGridTextColumn Header="Installed" Binding="{Binding InstallDateText}" Width="0.8*" SortMemberPath="InstallDateText" />
        <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="0.6*" SortMemberPath="SourceLabel" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Details -->
    <Border Grid.Row="2" Margin="0,10,0,0" Padding="14,12" CornerRadius="8"
            Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Visibility="{Binding SelectedApp, Converter={StaticResource EmptyStringToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding SelectedApp.DisplayName}" Style="{StaticResource SectionText}" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
            <Run Text="{Binding SelectedApp.Publisher, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding SelectedApp.Version, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding SelectedApp.InstallerLabel, Mode=OneWay}" />
            <Run Text=" · " />
            <Run Text="{Binding SelectedApp.ScopeLabel, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
            <Run Text="Install location: " />
            <Run Text="{Binding SelectedApp.InstallLocationText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
            <Run Text="Uninstall command: " />
            <Run Text="{Binding SelectedApp.UninstallCommandText, Mode=OneWay}" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Open folder" Margin="0,0,8,0" Click="OpenFolder_Click" />
          <Button Content="Uninstall" Style="{StaticResource PrimaryButton}" Click="Uninstall_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status -->
    <Grid Grid.Row="3" Margin="2,10,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
        <TextBlock Text=" · " Style="{StaticResource CaptionText}" Visibility="{Binding WarningText, Converter={StaticResource EmptyStringToVisibility}}" />
        <TextBlock Text="{Binding WarningText}" Style="{StaticResource CaptionText}" Foreground="{StaticResource ModerateBrush}"
                   Visibility="{Binding WarningText, Converter={StaticResource EmptyStringToVisibility}}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding ElevationText}" Style="{StaticResource CaptionText}" />
    </Grid>

    <ProgressBar Grid.Row="4" Height="3" Margin="0,10,0,0" IsIndeterminate="True"
                 Visibility="{Binding IsBusy, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
  </Grid>
</Window>
